# Same Supabase project as the desktop app. The anon key is public (protected by
# row-level security), so it's safe to ship. Create a local .env.local with these
# values, and set them in your Cloudflare build environment for production.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
